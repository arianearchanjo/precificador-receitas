# Modelo de variáveis — copie para .env.development (dev) ou .env.production e preencha.
# Ambos os arquivos são ignorados pelo git; este é o único commitável.

# Banco PostgreSQL (Neon)
# DATABASE_URL: string POOLED (host com "-pooler") — usada pela aplicação em runtime.
# DIRECT_URL: string DIRETA (sem "-pooler") — usada pelas migrations (db:migrate/db:deploy/db:studio).
DATABASE_URL=""
DIRECT_URL=""

# Better-Auth
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Desenvolvimento: http://localhost:3000 · Produção: https://seu-projeto.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Conta única de acesso (criada automaticamente no primeiro acesso à tela de login)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
