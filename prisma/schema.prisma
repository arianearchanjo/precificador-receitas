generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Autenticação (Better-Auth) — existe apenas para login.
// Nenhuma tabela de negócio se relaciona com User.
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ============================================================
// Negócio — global ao sistema, sem isolamento por usuário.
// ============================================================

/// Perfil do negócio. Uma única linha no banco.
model ConfiguracaoConfeitaria {
  id       Int     @id @default(1)
  nome     String
  telefone String?

  @@map("configuracao_confeitaria")
}

enum UnidadeIngrediente {
  g
  ml
  un
  kg
  l
}

model Ingrediente {
  id                 String             @id @default(cuid())
  nome               String
  precoPago          Decimal            @db.Decimal(10, 2)
  quantidadeComprada Decimal            @db.Decimal(10, 3)
  unidade            UnidadeIngrediente
  criadoEm           DateTime           @default(now())
  atualizadoEm       DateTime           @updatedAt

  receitas ReceitaIngrediente[]

  @@map("ingredientes")
}

model Receita {
  id              String   @id @default(cuid())
  nome            String
  rendimento      Int
  horasTrabalho   Decimal  @db.Decimal(6, 2)
  valorHora       Decimal  @db.Decimal(10, 2)
  custoEmbalagem  Decimal  @db.Decimal(10, 2) @default(0)
  custoGasEnergia Decimal  @db.Decimal(10, 2) @default(0)
  custosAdicionais Decimal @db.Decimal(10, 2) @default(0)
  taxaCartao      Decimal  @db.Decimal(5, 2)
  margemLucro     Decimal  @db.Decimal(5, 2)
  favorita        Boolean  @default(false)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  ingredientes ReceitaIngrediente[]

  @@map("receitas")
}

model ReceitaIngrediente {
  receitaId     String
  ingredienteId String
  quantidade    Decimal @db.Decimal(10, 3)

  receita     Receita     @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Restrict)

  @@id([receitaId, ingredienteId])
  @@map("receitas_ingredientes")
}
